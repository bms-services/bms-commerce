# =============================================================================
# BMS Storefront (Next.js) — Local Development
# Copy to .env and fill in your values. Never commit .env to git.
# =============================================================================

# --- Bagisto API ---
# Backend URL (no trailing slash). Local: http://localhost:8000
NEXT_PUBLIC_BAGISTO_ENDPOINT=http://localhost:8000

# Storefront API key — generate on backend: php artisan bagisto-api:generate-key
# Also check backend .env: STOREFRONT_PLAYGROUND_KEY
NEXT_PUBLIC_BAGISTO_STOREFRONT_KEY=pk_storefront_your_key_here
BAGISTO_STOREFRONT_KEY=pk_storefront_your_key_here

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# --- Application ---
COMPANY_NAME=BMS Services

# --- Currency (Indonesia) ---
NEXT_PUBLIC_CURRENCY_CODE=IDR
NEXT_PUBLIC_CURRENCY_LOCALE=id-ID

# --- Optional ---
# BAGISTO_SESSION=bagisto_session
# BAGISTO_REVALIDATION_SECRET=
# BAGISTO_STORE_DOMAIN=localhost:3000
# NEXT_SERVER_MAGENTO_PROTOCOL=https
